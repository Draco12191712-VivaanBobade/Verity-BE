{
  "format_version": "1.21.90",
  "animation_controllers": {
    "controller.animation.verity_smiler.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "stunned": "query.property('verity:state') == 'stunned'" },
            { "walk": "query.modified_move_speed > 0.05" }
          ]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            { "stunned": "query.property('verity:state') == 'stunned'" },
            { "idle": "query.modified_move_speed <= 0.05" }
          ]
        },
        "stunned": {
          "animations": ["stunned"],
          "transitions": [
            { "idle": "query.property('verity:state') != 'stunned'" }
          ]
        }
      }
    }
  }
}
