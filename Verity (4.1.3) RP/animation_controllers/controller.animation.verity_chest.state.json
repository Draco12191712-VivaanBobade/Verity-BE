{
  "format_version": "1.21.0",
  "animation_controllers": {
    "controller.animation.verity_chest.state": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "transitions": [
            { "peeking": "q.property('verity:state') == 'peeking'" },
            { "open": "q.property('verity:state') == 'open'" }
          ]
        },
        "peeking": {
          "animations": ["peek_in"],
          "transitions": [
            { "closed": "q.property('verity:state') == 'closed'" },
            { "open": "q.property('verity:state') == 'open'" }
          ]
        },
        "open": {
          "animations": ["open"],
          "transitions": [
            { "closing": "q.property('verity:state') != 'open'" }
          ]
        },
        "closing": {
          "animations": ["close"],
          "transitions": [
            { "closed": "q.all_animations_finished" }
          ]
        }
      }
    }
  }
}
