{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.verity.spawn": {
      "initial_state": "check_spawn",
      "states": {
        "check_spawn": {
          "transitions": [
            { "spawn_fall": "query.property('verity:play_spawn')" },
            { "idle": "!query.property('verity:play_spawn')" }
          ]
        },
        "spawn_fall": {
          "animations": [ "verity_fall" ],
          "transitions": [
            { "introduction": "query.all_animations_finished" }
          ]
        },
        "introduction": {
          "animations": [ "verity_introduction" ],
          "on_entry": [ "@s verity:begin_introduction" ],
          "on_exit": [ "@s verity:finish_spawn" ],
          "transitions": [
            { "idle": "query.all_animations_finished" }
          ]
        },
        "idle": {
          "animations": [ "verity_idle" ],
          "transitions": [
            { "held": "query.property('verity:is_held')" },
            { "talking": "query.property('verity:is_talking')" },
            { "rolling": "!query.property('verity:is_held') && query.is_moving" },
            { "falling": "!query.property('verity:is_held') && !query.is_on_ground && query.vertical_speed > 0.1" }
          ]
        },
        "held": {
          "transitions": [
            { "idle": "!query.property('verity:is_held')" }
          ]
        },
        "rolling": {
          "animations": [ "verity_roll" ],
          "transitions": [
            { "held": "query.property('verity:is_held')" },
            { "talking": "query.property('verity:is_talking')" },
            { "idle": "!query.is_moving" },
            { "falling": "!query.is_on_ground && query.vertical_speed > 0.1" }
          ]
        },
        "talking": {
          "on_entry": [
            "v.talk_speed = math.random(0.72, 1.25);"
          ],
          "animations": [ "verity_talk" ],
          "transitions": [
            { "held": "query.property('verity:is_held')" },
            { "idle": "!query.property('verity:is_talking')" },
            { "falling": "!query.is_on_ground && query.vertical_speed > 0.1" }
          ]
        },
        "falling": {
          "on_entry": [
            "/playsound falling @a"
          ],
          "animations": [ "verity_fall" ],
          "transitions": [
            { "held": "query.property('verity:is_held')" },
            { "talking": "query.property('verity:is_talking')" },
            { "idle": "query.is_on_ground" }
          ]
        }
      }
    }
  }
}
