{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "verity:box",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "shake": "animation.Box.shake",
        "open": "animation.Box.open",
        "box_controller": "controller.animation.box.main"
      },
      "scripts": {
        "animate": ["box_controller"]
      }
    },

    "component_groups": {
      "state_opening": {
        "minecraft:mark_variant": { "value": 1 },
        "minecraft:timer": {
          "looping": false,
          "time": 4.5917,
          "time_down_event": {
            "event": "box_finished",
            "target": "self"
          }
        }
      },
      "state_finished": {
        "minecraft:spawn_entity": {
          "entities": {
            "min_wait_time": 0,
            "max_wait_time": 0,
            "num_to_spawn": 1,
            "single_use": true,
            "spawn_entity": "verity:verity",
            "spawn_event": "verity:trigger_spawn_fall"
          }
        },
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["box", "inanimate"]
      },
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": "no"
        }
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:collision_box": {
        "width": 1.0,
        "height": 1.0
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "start_opening",
              "target": "self"
            },
            "cooldown": 999999,
            "interact_text": "action.interact.box"
          }
        ]
      }
    },

    "events": {
      "start_opening": {
         "add": { "component_groups": ["state_opening"] },
         "queue_command": {
         "command": "scriptevent verity:box_opening"
            }
        },
      "box_finished": {
        "remove": { "component_groups": ["state_opening"] },
        "add": { "component_groups": ["state_finished"] }
      }
    }
  }
}
