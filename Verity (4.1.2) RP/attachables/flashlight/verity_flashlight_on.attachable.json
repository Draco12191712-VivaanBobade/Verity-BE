{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "verity:flashlight_on",
			"materials": {
				"default": "entity_emissive_alpha",
				"enchanted": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/flashlight/entity/flashlight_on",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.verity_flashlight"
			},
			"render_controllers": ["controller.render.item_default"],
			"animations": {
				"hold_first_person_mainhand": "animation.verity_flashlight.hold_first_person_mainhand",
				"hold_first_person_offhand": "animation.verity_flashlight.hold_first_person_offhand",
				"hold_third_person": "animation.verity_flashlight.hold_third_person_mainhand"
			},
			"scripts": {
				"scale": "1",
				"animate": [
					{
						"hold_first_person_mainhand": "context.is_first_person == 1.0 && context.item_slot == 'main_hand'"
					},
					{
						"hold_first_person_offhand": "context.is_first_person == 1.0 && context.item_slot == 'off_hand'"
					},
					{ "hold_third_person": "context.is_first_person == 0.0" }
				]
			}
		}
	}
}
