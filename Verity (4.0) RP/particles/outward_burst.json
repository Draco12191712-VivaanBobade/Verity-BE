{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "verity:outward_burst",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/verity/particles/outwards_burst"
      }
    },

    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },

      "minecraft:emitter_rate_instant": {
        "num_particles": 40
      },

      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.76
      },

      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },

      "minecraft:particle_initial_speed": 1.4,

      "minecraft:particle_motion_dynamic": {},

      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#BEBEBE",
            "1.0": "#FFFFFF"
          }
        }
      },

      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.6 * (1.0 - math.pow(variable.particle_age / variable.particle_lifetime, 5.0))",
          "0.6 * (1.0 - math.pow(variable.particle_age / variable.particle_lifetime, 5.0))"
        ],
        "facing_camera_type": "rotate_xyz",
        "rotation": {
          "rotation": "variable.particle_age * 300"
        }
      }
    }
  }
}

