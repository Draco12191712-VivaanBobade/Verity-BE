{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "verity:smiler",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "verity:state": {
          "type": "enum",
          "values": ["idle", "stunned", "chasing"],
          "default": "idle",
          "client_sync": true
        }
      }
    },

    "component_groups": {

      "verity:c_idle": {
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6
        },
        "minecraft:behavior.random_look_around": {
          "priority": 7
        }
      },

      "verity:c_stunned": {
        "minecraft:movement": {
          "value": 0.0
        }
      },

      "verity:c_chasing": {
        "minecraft:movement": {
          "value": 0.65
        },
        "minecraft:follow_range": {
          "value": 1024
        },
        "minecraft:navigation.walk": {
          "can_walk": true,
          "can_jump": true,
          "can_break_doors": true,
          "can_pass_doors": true,
          "avoid_water": true,
          "blocks_to_avoid": [
            { "tags": "query.any_tag('trapdoors')" }
          ]
        },
        "minecraft:annotation.break_door": {
          "break_time": 4,
          "min_difficulty": "easy"
        },
        "minecraft:break_blocks": {
          "breakable_blocks": [
            "minecraft:glass",
            "minecraft:glass_pane",
            "minecraft:stained_glass",
            "minecraft:stained_glass_pane",
            "minecraft:oak_planks",
            "minecraft:dirt",
            "minecraft:cobblestone"
          ]
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 1024,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 1024
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "track_target": true,
          "reach_multiplier": 1.3
        },
        "minecraft:attack": {
          "damage": 15
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["verity_smiler", "monster"]
      },
      "minecraft:scale": {
        "value": 2.5
      },
      "minecraft:health": {
        "value": 60,
        "max": 60
      },
      "minecraft:collision_box": {
        "width": 1.2,
        "height": 7.0
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": "no"
        }
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_jump": true,
        "can_break_doors": false,
        "can_pass_doors": true,
        "avoid_water": true
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:can_climb": {},

      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 1024,
        "probability": 1.0
      },

      "minecraft:persistent": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      }
    },

    "events": {
      "verity:to_idle": {
        "set_property": { "verity:state": "idle" },
        "remove": { "component_groups": ["verity:c_stunned", "verity:c_chasing"] },
        "add": { "component_groups": ["verity:c_idle"] }
      },
      "verity:to_stunned": {
        "set_property": { "verity:state": "stunned" },
        "remove": { "component_groups": ["verity:c_idle", "verity:c_chasing"] },
        "add": { "component_groups": ["verity:c_stunned"] }
      },
      "verity:to_chasing": {
        "set_property": { "verity:state": "chasing" },
        "remove": { "component_groups": ["verity:c_idle", "verity:c_stunned"] },
        "add": { "component_groups": ["verity:c_chasing"] }
      },
      "minecraft:entity_spawned": {
        "set_property": { "verity:state": "idle" },
        "add": { "component_groups": ["verity:c_idle"] }
      }
    }
  }
}
